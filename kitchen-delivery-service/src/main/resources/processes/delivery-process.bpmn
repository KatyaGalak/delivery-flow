<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="DeliveryProcess" name="Delivery Process" isExecutable="true">

    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_SendPayment"/>

    <bpmn:serviceTask id="Task_SendPayment" name="Request Payment"
                      camunda:delegateExpression="${sendPaymentCommandDelegate}">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_SendPayment" targetRef="Gateway_PaymentResponse"/>

    <bpmn:eventBasedGateway id="Gateway_PaymentResponse">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <bpmn:intermediateCatchEvent id="Event_PaymentSuccess" name="Payment Received">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" messageRef="Message_PaymentReceived"/>
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="Event_PaymentFailed" name="Payment Failed">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_2" messageRef="Message_PaymentFailed"/>
    </bpmn:intermediateCatchEvent>

    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gateway_PaymentResponse" targetRef="Event_PaymentSuccess"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_PaymentResponse" targetRef="Event_PaymentFailed"/>

    <bpmn:serviceTask id="Task_NotifyFailed" name="Notify Order Failed"
                      camunda:delegateExpression="${notifyOrderFailedDelegate}">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_EndFailed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Event_PaymentFailed" targetRef="Task_NotifyFailed"/>
    <bpmn:sequenceFlow id="Flow_EndFailed" sourceRef="Task_NotifyFailed" targetRef="EndEvent_Failed"/>
    <bpmn:endEvent id="EndEvent_Failed">
      <bpmn:incoming>Flow_EndFailed</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Task_PrepareFood" name="Prepare Food" camunda:candidateGroups="ROLE_RESTAURANT">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Event_PaymentSuccess" targetRef="Task_PrepareFood"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_PrepareFood" targetRef="Task_DeliverFood"/>

    <bpmn:boundaryEvent id="Timer_PrepareTimeout" name="Prepare Timeout"
                        attachedToRef="Task_PrepareFood" cancelActivity="true">
      <bpmn:outgoing>Flow_PrepareTimeout</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Prepare">
        <bpmn:timeDuration>PT1M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_PrepareTimeout" sourceRef="Timer_PrepareTimeout" targetRef="Task_SetCancelReason_Prepare"/>

    <bpmn:serviceTask id="Task_SetCancelReason_Prepare" name="Set Cancel Reason (Prepare)"
                      camunda:delegateExpression="${setCancelReasonPrepareDelegate}">
      <bpmn:incoming>Flow_PrepareTimeout</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRefund_FromPrepare</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToRefund_FromPrepare" sourceRef="Task_SetCancelReason_Prepare" targetRef="Task_RequestRefund"/>

    <bpmn:userTask id="Task_DeliverFood" name="Deliver Food" camunda:candidateGroups="ROLE_COURIER">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_DeliverFood" targetRef="Task_NotifyCompleted"/>

    <bpmn:boundaryEvent id="Timer_DeliverTimeout" name="Deliver Timeout"
                        attachedToRef="Task_DeliverFood" cancelActivity="true">
      <bpmn:outgoing>Flow_DeliverTimeout</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Deliver">
        <bpmn:timeDuration>PT1M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_DeliverTimeout" sourceRef="Timer_DeliverTimeout" targetRef="Task_SetCancelReason_Deliver"/>

    <bpmn:serviceTask id="Task_SetCancelReason_Deliver" name="Set Cancel Reason (Deliver)"
                      camunda:delegateExpression="${setCancelReasonDeliverDelegate}">
      <bpmn:incoming>Flow_DeliverTimeout</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRefund_FromDeliver</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToRefund_FromDeliver" sourceRef="Task_SetCancelReason_Deliver" targetRef="Task_RequestRefund"/>

    <bpmn:serviceTask id="Task_RequestRefund" name="Request Refund"
                      camunda:delegateExpression="${sendRefundCommandDelegate}">
      <bpmn:incoming>Flow_ToRefund_FromPrepare</bpmn:incoming>
      <bpmn:incoming>Flow_ToRefund_FromDeliver</bpmn:incoming>
      <bpmn:outgoing>Flow_AfterRefund</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_AfterRefund" sourceRef="Task_RequestRefund" targetRef="Task_NotifyCancelled"/>

    <bpmn:serviceTask id="Task_NotifyCancelled" name="Notify Order Cancelled"
                      camunda:delegateExpression="${notifyOrderCancelledDelegate}">
      <bpmn:incoming>Flow_AfterRefund</bpmn:incoming>
      <bpmn:outgoing>Flow_EndCancelled</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EndCancelled" sourceRef="Task_NotifyCancelled" targetRef="EndEvent_Cancelled"/>
    <bpmn:endEvent id="EndEvent_Cancelled">
      <bpmn:incoming>Flow_EndCancelled</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_NotifyCompleted" name="Notify Order Completed"
                      camunda:delegateExpression="${notifyOrderCompletedDelegate}">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_EndSuccess</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_EndSuccess" sourceRef="Task_NotifyCompleted" targetRef="EndEvent_Success"/>
    <bpmn:endEvent id="EndEvent_Success">
      <bpmn:incoming>Flow_EndSuccess</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <bpmn:message id="Message_PaymentReceived" name="PaymentReceivedMessage"/>
  <bpmn:message id="Message_PaymentFailed" name="PaymentFailedMessage"/>
</bpmn:definitions>